rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().exists && userDoc().data.role == "superAdmin";
    }

    function isAdmin() {
      return isSignedIn() && userDoc().exists && userDoc().data.role in ["admin", "superAdmin"];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user";

      allow update: if isSuperAdmin()
        || (
          isSignedIn()
          && userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "uid"])
        );

      allow delete: if isSuperAdmin();
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.archived == false;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["userId", "status", "archived"])
        );

      allow delete: if isSuperAdmin();
    }
  }
}
